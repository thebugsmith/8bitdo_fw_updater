# 8BitDo controllers over raw HID (firmware flashing with 8bitdo-fw.py).
#
# Install:
#   sudo cp 99-8bitdo-hidraw.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger --subsystem-match=hidraw
#
# Vendor-scoped on purpose: every 8BitDo device that has a firmware updater
# presents vendor id 0x2dc8 (the vendor's own web updater filters on exactly
# that id, 23 product ids, no other vendor), so one rule covers the whole line,
# including the bootloader modes (e.g. 2dc8:3208).
#
# MODE is what grants access. TAG+="uaccess" only adds a systemd-logind ACL,
# which exists for a logged-in local seat — over SSH or on a headless box the
# ACL is absent and the open still fails without MODE.
#
# 0666 is deliberate (no group to manage, works for any user). Tighten to
# MODE="0660", GROUP="plugdev" if that suits the machine better.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2dc8", MODE="0666", TAG+="uaccess"
